NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Your project's publishable key (sb_publishable_...) or legacy anon key (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_key

# Stripe sandbox (test mode) keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Printed by scripts/create-webhook.mjs
STRIPE_WEBHOOK_SECRET=whsec_...

# Any long random string; its SHA-256 hash goes in private.settings (see supabase/stripe.sql)
SERVER_RPC_SECRET=
